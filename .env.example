# URL และบัญชีสำหรับ Test Environment เท่านั้น
CONX_BASE_URL=https://your-conx-test-environment.example.com
CONX_USERNAME=tester@example.com
CONX_PASSWORD=change-me
PARKING_OUTPUT_DIR=./output
IAM_DATABASE_URL=postgresql://username:password@host/database
AM_DATABASE_URL=postgresql://username:password@host/ob_iam_uat
RUN_DB_VALIDATION=false

# จำนวนแถวที่ต้องการตรวจในแต่ละรอบ
ROW_LIMIT=1000

# เริ่มต้นด้วยไฟล์ JSON; เปลี่ยนเป็น database หลังเชื่อม DB adapter แล้ว
DATA_SOURCE=json
RECORDS_FILE=./data/records.example.json

# ตัวอย่างค่าที่จะใช้ตอนเชื่อมฐานข้อมูลจริง
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_QUERY=SELECT id, email, status, full_name FROM customer ORDER BY id LIMIT 20

# Bus Ride PocketBase
PB_URL=https://uat-qrverify.opsioc.com/api/
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=
CONX_MODIFIED_USER=
PB_INSECURE_TLS=true
